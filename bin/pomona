#!/bin/bash
# Pomona - bring the Apple T1 (Touch Bar, FaceTime camera, ambient light sensor)
# back to life on 2016-2017 MacBook Pro running Linux.
#
#   pomona start      boot the T1 and bind its devices (what the service runs at boot)
#   pomona stop       release the T1 before power-off (what the service runs at shutdown)
#   pomona status     one screen with the state of every piece (--json for the GUI)
#   pomona certify    run the checks and write a compatibility certificate
#   pomona share      open your latest certificate as a pre-filled GitHub report
#   pomona wifi       Broadcom Wi-Fi: status | fix | undo | certify  (pomona wifi help)
#   pomona audio      Cirrus Logic sound: status | fix | undo | certify  (pomona audio help)
#   pomona diagnose   Pomona got it wrong? MODULE (t1|wifi|audio) works|broken: a report to share
#   pomona version
#
# SPDX-License-Identifier: GPL-3.0-or-later
set -uo pipefail

_self=$(readlink -f -- "${BASH_SOURCE[0]}")
for _lib in "${POMONA_LIB:-}" "$(dirname "$_self")/../lib/pomona/pomona.sh" "$(dirname "$_self")/../lib/pomona.sh" /usr/lib/pomona/pomona.sh /usr/local/lib/pomona/pomona.sh; do
	[ -n "$_lib" ] && [ -r "$_lib" ] && { . "$_lib"; break; }
done
declare -F et1_start >/dev/null || { echo "pomona: cannot find lib/pomona.sh" >&2; exit 1; }

yesno() { if "$@"; then echo yes; else echo no; fi; }
svc() { local s; s=$(systemctl is-active "$1" 2>/dev/null); echo "${s:-unknown}"; }
svc_enabled() { local s; s=$(systemctl is-enabled "$1" 2>/dev/null); echo "${s:-not-installed}"; }

jbool() { if "$@"; then echo true; else echo false; fi; }

cmd_status_json() {
	local model fw
	model=$(et1_model)
	fw=$(et1_find_firmware || true)
	cat <<EOF
{
  "version": $(json_str "$POMONA_VERSION"),
  "model": $(json_str "$model"),
  "model_class": $(json_str "$(et1_model_class "$model")"),
  "compat": $(json_str "$(et1_compat_status "$model")"),
  "board": $(json_str "$(et1_dmi board_name)"),
  "mac_firmware": $(json_str "$(et1_dmi bios_version)"),
  "kernel": $(json_str "$(uname -r)"),
  "distribution": $(json_str "$(et1_os_field PRETTY_NAME)"),
  "t1_state": $(json_str "$(et1_t1_state)"),
  "t1_product": $(json_str "$(et1_t1_attr product)"),
  "camera_name": $(json_str "$(et1_camera_name)"),
  "usb_config": $(json_str "$(et1_usb_config || true)"),
  "firmware": $(json_str "$fw"),
  "firmware_version": $(json_str "$([ -n "$fw" ] && et1_firmware_version "$fw")"),
  "firmware_images": $([ -n "$fw" ] && et1_count_img4 "$fw" || echo 0),
  "touchbar_bound": $(jbool et1_tb_bound),
  "touchbar_driver_available": $(jbool et1_tb_driver_available),
  "camera": $(jbool et1_camera_present),
  "light_sensor": $(jbool et1_als_present),
  "boot_service": $(json_str "$(svc_enabled pomona.service)"),
  "touchbar_service": $(json_str "$(svc pomona-touchbard.service)"),
  "installed": $(jbool et1_installed)
}
EOF
}

cmd_status() {
	[ "${1:-}" = --json ] && { cmd_status_json; return; }
	local model fw
	model=$(et1_model)
	fw=$(et1_find_firmware || true)
	cat <<EOF
Pomona $POMONA_VERSION
model            ${model:-unknown} ($(et1_model_class "$model"), $(et1_compat_status "$model"))
T1               $(et1_t1_state)  (USB configuration: $(et1_usb_config || true))
firmware on ESP  ${fw:-missing}${fw:+  (version $(et1_firmware_version "$fw"))}
Touch Bar driver $(yesno et1_tb_bound)
camera           $(yesno et1_camera_present)
light sensor     $(yesno et1_als_present)
services         pomona: $(svc_enabled pomona.service), touchbar: $(svc pomona-touchbard.service)
EOF
}

# ------------------------------------------------------------------ certify

# json_str S -> S as a JSON string literal
json_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

cmd_certify() {
	local out_dir=${1:-$PWD} model class compat stamp base fw fwver nimg t1 cfg tb cam als fnsvc bootsvc
	local verdict checks=() pass=0 total=0 name ok
	model=$(et1_model); class=$(et1_model_class "$model"); compat=$(et1_compat_status "$model")
	stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	fw=$(et1_find_firmware || true)
	fwver=""; nimg=0
	if [ -n "$fw" ]; then fwver=$(et1_firmware_version "$fw"); nimg=$(et1_count_img4 "$fw"); fi
	t1=$(et1_t1_state); cfg=$(et1_usb_config || true)
	tb=$(yesno et1_tb_bound); cam=$(yesno et1_camera_present); als=$(yesno et1_als_present)
	bootsvc=$(svc_enabled pomona.service)
	fnsvc=$(svc pomona-touchbard.service)

	check() { total=$((total + 1)); if [ "$2" = yes ]; then pass=$((pass + 1)); fi; checks+=("$1|$2"); }
	check "T1 MacBook Pro model" "$([ "$class" = t1 ] && echo yes || echo no)"
	check "EmbeddedOS firmware on the EFI partition" "$([ -n "$fw" ] && echo yes || echo no)"
	check "Firmware holds 4 signed images" "$([ "$nimg" -ge 4 ] 2>/dev/null && echo yes || echo no)"
	check "T1 running (05ac:8600)" "$([ "$t1" = booted ] && echo yes || echo no)"
	check "USB configuration 1 selected" "$([ "$cfg" = 1 ] && echo yes || echo no)"
	check "Touch Bar bound to hid-appletb-kbd" "$tb"
	check "FaceTime camera present" "$cam"
	check "Ambient light sensor present" "$als"
	check "Boot service enabled" "$([ "$bootsvc" = enabled ] && echo yes || echo no)"
	check "Touch Bar daemon running" "$([ "$fnsvc" = active ] && echo yes || echo no)"

	if [ "$pass" = "$total" ]; then verdict=WORKING
	elif [ "$t1" = booted ]; then verdict=PARTIAL
	else verdict=NOT-WORKING; fi

	base="$out_dir/pomona-certificate-${model:-unknown}-$(date -u +%Y%m%d-%H%M%S)"
	base=${base//,/_}
	{
		echo "# Pomona compatibility certificate"
		echo
		echo "**Result: $verdict** ($pass/$total checks passed)"
		echo
		echo "| Field | Value |"
		echo "| --- | --- |"
		echo "| Date (UTC) | $stamp |"
		echo "| Pomona | $POMONA_VERSION |"
		echo "| Model | ${model:-unknown} |"
		echo "| Board | $(et1_dmi board_name) |"
		echo "| Mac firmware | $(et1_dmi bios_version) ($(et1_dmi bios_date)) |"
		echo "| T1 EmbeddedOS on ESP | ${fwver:-n/a} |"
		echo "| Distribution | $(et1_os_field PRETTY_NAME) |"
		echo "| Kernel | $(uname -r) |"
		echo "| Desktop | ${XDG_CURRENT_DESKTOP:-n/a} (${XDG_SESSION_TYPE:-n/a}) |"
		echo
		echo "| Check | Result |"
		echo "| --- | --- |"
		for c in "${checks[@]}"; do name=${c%|*}; ok=${c##*|}; echo "| $name | $([ "$ok" = yes ] && echo PASS || echo FAIL) |"; done
		echo
		echo "Pomona is provided as is, without warranty, and is not affiliated with Apple Inc."
		echo
		echo "No serial numbers, ECID or UUIDs are included. To add your Mac to the compatibility"
		echo "table, run: pomona share"
	} > "$base.md"
	{
		echo "{"
		echo "  \"schema\": 1,"
		echo "  \"date\": $(json_str "$stamp"),"
		echo "  \"pomona\": $(json_str "$POMONA_VERSION"),"
		echo "  \"result\": $(json_str "$verdict"),"
		echo "  \"model\": $(json_str "$model"),"
		echo "  \"board\": $(json_str "$(et1_dmi board_name)"),"
		echo "  \"mac_firmware\": $(json_str "$(et1_dmi bios_version)"),"
		echo "  \"embeddedos\": $(json_str "$fwver"),"
		echo "  \"distribution\": $(json_str "$(et1_os_field PRETTY_NAME)"),"
		echo "  \"kernel\": $(json_str "$(uname -r)"),"
		echo "  \"desktop\": $(json_str "${XDG_CURRENT_DESKTOP:-}"),"
		echo "  \"checks\": {"
		local i=0
		for c in "${checks[@]}"; do
			i=$((i + 1)); name=${c%|*}; ok=${c##*|}
			printf '    %s: %s%s\n' "$(json_str "$name")" "$([ "$ok" = yes ] && echo true || echo false)" "$([ "$i" -lt "${#checks[@]}" ] && echo ,)"
		done
		echo "  }"
		echo "}"
	} > "$base.json"
	cat "$base.md"
	echo
	echo "written: $base.md"
	echo "         $base.json"
	[ "$verdict" = WORKING ]
}

cmd_share() {
	local file="" url_only=0 a url
	for a in "$@"; do
		case "$a" in
			--url) url_only=1;;
			-*) et1_err "unknown option $a"; return 2;;
			*) file=$a;;
		esac
	done
	[ -n "$file" ] || file=$(et1_latest_certificate) || { et1_err "no certificate found: run  pomona certify  first"; return 1; }
	[ -r "$file" ] || { et1_err "cannot read $file"; return 1; }
	url=$(et1_share_url "$file") || { et1_err "$file is not a Pomona certificate"; return 1; }
	if [ "$url_only" = 1 ]; then printf '%s\n' "$url"; return 0; fi
	echo "Certificate: $file"
	echo "Your browser will open a GitHub page with the certificate already filled in."
	echo "Nothing is sent until you press \"Submit new issue\" there (a GitHub account is needed)."
	if [ "$(id -u)" = 0 ] || ! command -v xdg-open >/dev/null; then
		echo; echo "Open this address in your browser:"; echo "$url"; return 0
	fi
	xdg-open "$url" >/dev/null 2>&1 &
}

# ------------------------------------------------------------------ wifi

wifi_help() {
	cat <<'EOF'
pomona wifi status [--json]    what is in place and what is missing
sudo pomona wifi fix           install the board file and settings (backed up first); then restart
      --keep-mac               keep the MAC address already in the board file
      --mac aa:bb:cc:dd:ee:ff  use this MAC address
      --download               agree to download the board file (otherwise you are asked)
      --board-file FILE        use this copy of the board file instead of downloading it
      --force                  install even if the card is not found
sudo pomona wifi undo          put the files back as they were before the last fix
pomona wifi certify [DIR]      run the checks and write a compatibility certificate
EOF
}

wifi_status_json() {
	local model
	model=$(et1_model)
	cat <<EOF
{
  "version": $(json_str "$POMONA_VERSION"),
  "model": $(json_str "$model"),
  "model_class": $(json_str "$(et1_model_class "$model")"),
  "state": $(json_str "$(wf_state)"),
  "any_interface": $(json_str "$(wf_any_iface)"),
  "any_driver": $(json_str "$(wf_any_attr driver)"),
  "any_pci": $(json_str "$(wf_any_attr pci)"),
  "any_operstate": $(json_str "$(wf_any_attr operstate)"),
  "any_mac": $(json_str "$(wf_any_attr mac)"),
  "kernel": $(json_str "$(uname -r)"),
  "present": $(jbool wf_present),
  "subsystem": $(json_str "$(wf_subsystem)"),
  "driver": $(json_str "$(wf_driver)"),
  "interface": $(json_str "$(wf_iface)"),
  "operstate": $(json_str "$(wf_operstate)"),
  "mac": $(json_str "$(wf_mac)"),
  "board_file_installed": $(jbool wf_nvram_installed),
  "board_file_ok": $(jbool wf_nvram_ok),
  "board_file_mac": $(json_str "$(wf_nvram_mac)"),
  "mac_is_placeholder": $(jbool wf_mac_placeholder),
  "networkmanager": $(jbool wf_nm_installed),
  "networkmanager_ok": $(jbool wf_nm_ok),
  "driver_option_ok": $(jbool wf_modprobe_ok),
  "restart_pending": $(jbool wf_restart_pending),
  "backup": $(json_str "$(wf_latest_backup || true)"),
  "board_file_cached": $(jbool wf_cache_ok),
  "installed": $(jbool et1_installed)
}
EOF
}

wifi_status() {
	[ "${1:-}" = --json ] && { wifi_status_json; return; }
	if ! wf_present; then
		echo "No Broadcom BCM43602 Wi-Fi card (14e4:43ba) found on this machine."
		return 0
	fi
	local state
	state=$(wf_state)
	cat <<EOF
Wi-Fi card       BCM43602 [14e4:43ba], subsystem $(wf_subsystem)
driver           $(wf_driver || true)
interface        $(wf_iface) ($(wf_operstate)), MAC $(wf_mac)
board file       $(wf_nvram_ok && echo "installed" || { wf_nvram_installed && echo "installed, but not the expected file" || echo "missing"; })$(wf_mac_placeholder && echo "  (shared default MAC address: run  sudo pomona wifi fix  to give this Mac its own)")
NetworkManager   $(wf_nm_installed && { wf_nm_ok && echo "keeps the real MAC address" || echo "randomises the MAC address"; } || echo "not used")
driver option    $(wf_modprobe_ok && echo "feature_disable=$(wf_feature_disable)" || echo "not set")
state            $state
EOF
	case "$state" in
		needs-fix) echo; echo "Run  sudo pomona wifi fix  and restart.";;
		restart) echo; echo "Restart the computer to load the driver with the new board file.";;
	esac
}

cmd_wifi_certify() {
	local out_dir=${1:-$PWD} model class stamp base sub iface pass=0 total=0 verdict checks=() name ok c i
	model=$(et1_model); class=$(et1_model_class "$model")
	stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	sub=$(wf_subsystem); iface=$(wf_iface)

	check() { total=$((total + 1)); if [ "$2" = yes ]; then pass=$((pass + 1)); fi; checks+=("$1|$2"); }
	check "Supported MacBook Pro model" "$([ "$class" = t1 ] && echo yes || echo no)"
	check "Broadcom BCM43602 Wi-Fi chip (14e4:43ba)" "$(yesno wf_present)"
	check "brcmfmac driver bound" "$(yesno wf_driver_ok)"
	check "Board file installed" "$(yesno wf_nvram_ok)"
	check "NetworkManager keeps the real MAC address" "$(yesno wf_nm_ok)"
	check "Driver option feature_disable set" "$(yesno wf_modprobe_ok)"
	check "Wi-Fi interface present" "$([ -n "$iface" ] && echo yes || echo no)"
	check "Connected to a network" "$(yesno wf_connected)"
	check "No restart pending" "$(if wf_restart_pending; then echo no; else echo yes; fi)"

	if [ "$pass" = "$total" ]; then verdict=WORKING
	elif [ -n "$iface" ]; then verdict=PARTIAL
	else verdict=NOT-WORKING; fi

	base="$out_dir/pomona-certificate-wifi-${model:-unknown}-$(date -u +%Y%m%d-%H%M%S)"
	base=${base//,/_}
	{
		echo "# Pomona Wi-Fi compatibility certificate"
		echo
		echo "**Result: $verdict** ($pass/$total checks passed)"
		echo
		echo "| Field | Value |"
		echo "| --- | --- |"
		echo "| Date (UTC) | $stamp |"
		echo "| Pomona | $POMONA_VERSION |"
		echo "| Model | ${model:-unknown} |"
		echo "| Board | $(et1_dmi board_name) |"
		echo "| Mac firmware | $(et1_dmi bios_version) ($(et1_dmi bios_date)) |"
		echo "| Wi-Fi card subsystem | ${sub:-n/a} |"
		echo "| Distribution | $(et1_os_field PRETTY_NAME) |"
		echo "| Kernel | $(uname -r) |"
		echo "| Desktop | ${XDG_CURRENT_DESKTOP:-n/a} (${XDG_SESSION_TYPE:-n/a}) |"
		echo
		echo "| Check | Result |"
		echo "| --- | --- |"
		for c in "${checks[@]}"; do name=${c%|*}; ok=${c##*|}; echo "| $name | $([ "$ok" = yes ] && echo PASS || echo FAIL) |"; done
		echo
		echo "Pomona is provided as is, without warranty, and is not affiliated with Apple Inc. or Broadcom Inc."
		echo
		echo "No serial numbers, MAC addresses, network names or UUIDs are included. To add your Mac to the"
		echo "compatibility table, run: pomona share"
	} > "$base.md"
	{
		echo "{"
		echo "  \"schema\": 2,"
		echo "  \"module\": \"wifi\","
		echo "  \"date\": $(json_str "$stamp"),"
		echo "  \"pomona\": $(json_str "$POMONA_VERSION"),"
		echo "  \"result\": $(json_str "$verdict"),"
		echo "  \"model\": $(json_str "$model"),"
		echo "  \"board\": $(json_str "$(et1_dmi board_name)"),"
		echo "  \"mac_firmware\": $(json_str "$(et1_dmi bios_version)"),"
		echo "  \"subsystem\": $(json_str "$sub"),"
		echo "  \"distribution\": $(json_str "$(et1_os_field PRETTY_NAME)"),"
		echo "  \"kernel\": $(json_str "$(uname -r)"),"
		echo "  \"desktop\": $(json_str "${XDG_CURRENT_DESKTOP:-}"),"
		echo "  \"checks\": {"
		i=0
		for c in "${checks[@]}"; do
			i=$((i + 1)); name=${c%|*}; ok=${c##*|}
			printf '    %s: %s%s\n' "$(json_str "$name")" "$([ "$ok" = yes ] && echo true || echo false)" "$([ "$i" -lt "${#checks[@]}" ] && echo ,)"
		done
		echo "  }"
		echo "}"
	} > "$base.json"
	cat "$base.md"
	echo
	echo "written: $base.md"
	echo "         $base.json"
	[ "$verdict" = WORKING ]
}

cmd_wifi() {
	case "${1:-status}" in
		status) shift; wifi_status "$@";;
		fix) shift; wf_fix "$@";;
		undo) shift; wf_undo "$@";;
		certify) shift; cmd_wifi_certify "$@";;
		help|-h|--help) wifi_help;;
		*) et1_err "unknown wifi command $1 (try: pomona wifi help)"; return 2;;
	esac
}

# ------------------------------------------------------------------ audio

audio_help() {
	cat <<'EOF'
pomona audio status [--json]   what is in place and what is missing
sudo pomona audio fix          download and build the Mac sound driver (DKMS); then restart
      --download               agree to download the driver and the kernel source (otherwise you are asked)
      --force                  install even if the sound chip is not found
sudo pomona audio undo         remove the driver: the kernel's own one is used again after a restart
pomona audio certify [DIR]     run the checks and write a compatibility certificate
EOF
}

audio_status_json() {
	local model
	model=$(et1_model)
	cat <<EOF
{
  "version": $(json_str "$POMONA_VERSION"),
  "model": $(json_str "$model"),
  "model_class": $(json_str "$(et1_model_class "$model")"),
  "state": $(json_str "$(au_state)"),
  "kernel": $(json_str "$(uname -r)"),
  "present": $(jbool au_present),
  "supported": $(jbool au_supported),
  "subsystem": $(json_str "$(au_subsystem)"),
  "chip_name": $(json_str "$(au_chip_name)"),
  "driver": $(json_str "$(au_driver)"),
  "active": $(jbool au_active),
  "package": $(json_str "$(au_installed_sources | head -n1)"),
  "package_version": $(json_str "$AU_PKG_VERSION"),
  "module_built": $(jbool au_module_built),
  "foreign": $(json_str "$(au_foreign || true)"),
  "missing_tools": $(json_str "$(au_missing_tools)"),
  "restart_pending": $(jbool au_restart_pending),
  "installed": $(jbool et1_installed)
}
EOF
}

audio_status() {
	[ "${1:-}" = --json ] && { audio_status_json; return; }
	if ! au_present; then
		echo "No Cirrus Logic CS8409 sound chip found on this machine."
		return 0
	fi
	local state other
	state=$(au_state)
	cat <<EOF
sound chip       Cirrus Logic CS8409 [$AU_VENDOR_ID], subsystem $(au_subsystem)$(au_supported || echo "  (not one the driver knows)")
codec name       $(au_chip_name)  ($(au_active && echo "Mac driver in use" || echo "kernel's own driver: speakers silent"))
DKMS package     $(au_package_added && echo "$AU_PKG/$AU_PKG_VERSION, module $(au_module_built && echo "built for $(uname -r)" || echo "NOT built for $(uname -r)")" || echo "not installed")
state            $state
EOF
	case "$state" in
		needs-fix) echo; echo "Run  sudo pomona audio fix  and restart.";;
		restart) echo; echo "Restart the computer to load the new driver.";;
		failed) echo; echo "The driver could not be built for this kernel (no connection during the update?). Run  sudo pomona audio fix  again.";;
		foreign) other=$(au_foreign); echo; echo "Another copy of the driver is installed ($other): see docs/audio.md.";;
		unsupported) echo; echo "The driver does not know this Mac's amplifiers yet.";;
	esac
}

cmd_audio_certify() {
	local out_dir=${1:-$PWD} model class stamp base sub pass=0 total=0 verdict checks=() name ok c i
	model=$(et1_model); class=$(et1_model_class "$model")
	stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	# 0x106b3900 -> 106b:3900, the form certificates use for every subsystem id
	sub=$(au_subsystem); sub=${sub#0x}; [ -n "$sub" ] && sub="${sub:0:4}:${sub:4:4}"

	check() { total=$((total + 1)); if [ "$2" = yes ]; then pass=$((pass + 1)); fi; checks+=("$1|$2"); }
	check "Supported MacBook Pro model" "$([ "$class" = t1 ] && echo yes || echo no)"
	check "Cirrus Logic CS8409 sound chip (10138409)" "$(yesno au_present)"
	check "Amplifiers known to the driver" "$(yesno au_supported)"
	check "DKMS package installed" "$(yesno au_package_added)"
	check "Driver built for the running kernel" "$(yesno au_module_built)"
	check "No other copy of the driver" "$(if au_foreign >/dev/null; then echo no; else echo yes; fi)"
	check "Mac driver in use (CS8409/CS42L83)" "$(yesno au_active)"
	check "No restart pending" "$(if [ "$(au_state)" = restart ]; then echo no; else echo yes; fi)"

	if [ "$pass" = "$total" ]; then verdict=WORKING
	elif au_active; then verdict=PARTIAL
	else verdict=NOT-WORKING; fi

	base="$out_dir/pomona-certificate-audio-${model:-unknown}-$(date -u +%Y%m%d-%H%M%S)"
	base=${base//,/_}
	{
		echo "# Pomona audio compatibility certificate"
		echo
		echo "**Result: $verdict** ($pass/$total checks passed)"
		echo
		echo "| Field | Value |"
		echo "| --- | --- |"
		echo "| Date (UTC) | $stamp |"
		echo "| Pomona | $POMONA_VERSION |"
		echo "| Model | ${model:-unknown} |"
		echo "| Board | $(et1_dmi board_name) |"
		echo "| Mac firmware | $(et1_dmi bios_version) ($(et1_dmi bios_date)) |"
		echo "| Sound chip subsystem | ${sub:-n/a} |"
		echo "| Distribution | $(et1_os_field PRETTY_NAME) |"
		echo "| Kernel | $(uname -r) |"
		echo "| Desktop | ${XDG_CURRENT_DESKTOP:-n/a} (${XDG_SESSION_TYPE:-n/a}) |"
		echo
		echo "| Check | Result |"
		echo "| --- | --- |"
		for c in "${checks[@]}"; do name=${c%|*}; ok=${c##*|}; echo "| $name | $([ "$ok" = yes ] && echo PASS || echo FAIL) |"; done
		echo
		echo "Pomona is provided as is, without warranty, and is not affiliated with Apple Inc. or Cirrus Logic, Inc."
		echo
		echo "No serial numbers or UUIDs are included. To add your Mac to the compatibility table, run: pomona share"
	} > "$base.md"
	{
		echo "{"
		echo "  \"schema\": 2,"
		echo "  \"module\": \"audio\","
		echo "  \"date\": $(json_str "$stamp"),"
		echo "  \"pomona\": $(json_str "$POMONA_VERSION"),"
		echo "  \"result\": $(json_str "$verdict"),"
		echo "  \"model\": $(json_str "$model"),"
		echo "  \"board\": $(json_str "$(et1_dmi board_name)"),"
		echo "  \"mac_firmware\": $(json_str "$(et1_dmi bios_version)"),"
		echo "  \"subsystem\": $(json_str "$sub"),"
		echo "  \"distribution\": $(json_str "$(et1_os_field PRETTY_NAME)"),"
		echo "  \"kernel\": $(json_str "$(uname -r)"),"
		echo "  \"desktop\": $(json_str "${XDG_CURRENT_DESKTOP:-}"),"
		echo "  \"checks\": {"
		i=0
		for c in "${checks[@]}"; do
			i=$((i + 1)); name=${c%|*}; ok=${c##*|}
			printf '    %s: %s%s\n' "$(json_str "$name")" "$([ "$ok" = yes ] && echo true || echo false)" "$([ "$i" -lt "${#checks[@]}" ] && echo ,)"
		done
		echo "  }"
		echo "}"
	} > "$base.json"
	cat "$base.md"
	echo
	echo "written: $base.md"
	echo "         $base.json"
	[ "$verdict" = WORKING ]
}

cmd_audio() {
	case "${1:-status}" in
		status) shift; audio_status "$@";;
		fix) shift; au_fix "$@";;
		undo) shift; au_undo "$@";;
		certify) shift; cmd_audio_certify "$@";;
		help|-h|--help) audio_help;;
		*) et1_err "unknown audio command $1 (try: pomona audio help)"; return 2;;
	esac
}

# ------------------------------------------------------------------ diagnose

# cmd_diagnose MODULE works|broken [DIR]: Pomona's verdict on this page is wrong. Writes
# pomona-diagnostic-MODULE-*.json with what the module checked (whitelisted, see
# tools/diagnostics.py) and, unless --no-share, opens it as a pre-filled GitHub report.
#   works:  Pomona says something is wrong, but it works
#   broken: Pomona says everything works, but something is wrong
cmd_diagnose() {
	local module=${1:-} verdict=${2:-} out_dir=$PWD share=1 a json base
	shift 2 2>/dev/null || true
	for a in "$@"; do
		case "$a" in
			--no-share) share=0;;
			-*) et1_err "unknown option $a"; return 2;;
			*) out_dir=$a;;
		esac
	done
	case "$module" in t1|wifi|audio) ;; *) et1_err "usage: pomona diagnose t1|wifi|audio works|broken [DIR] [--no-share]"; return 2;; esac
	case "$verdict" in works|broken) ;; *) et1_err "usage: pomona diagnose t1|wifi|audio works|broken [DIR] [--no-share]"; return 2;; esac
	case "$module" in
		t1) json=$(cmd_status_json);;
		wifi) json=$(wifi_status_json);;
		audio) json=$(audio_status_json);;
	esac
	local dkms=""
	if [ "$module" = audio ] && command -v dkms >/dev/null; then
		dkms=$(dkms status 2>/dev/null | grep -E "^($AU_PKG|snd_hda_macbookpro)" | head -n 3 | tr '\n' ';')
	fi
	base="$out_dir/pomona-diagnostic-$module-$(et1_model | tr ',' '_')-$(date -u +%Y%m%d-%H%M%S)"
	python3 -I - "$base.json" "$module" "$verdict" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
		"$POMONA_VERSION" "$(et1_model)" "$(et1_dmi board_name)" "$(et1_dmi bios_version)" \
		"$(et1_os_field PRETTY_NAME)" "$(uname -r)" "${XDG_CURRENT_DESKTOP:-}" "$dkms" "$json" <<'PYEOF' || return 1
import json, re, sys
out, module, verdict, date, pomona, model, board, fw, distro, kernel, desktop, dkms, status = sys.argv[1:14]
status = json.loads(status)
# what each module may report: the facts its page is built from. Never MAC addresses, network
# names, paths in the home folder or serial numbers. Keep in step with tools/diagnostics.py.
FACTS = {
    "t1": ["model_class", "compat", "t1_state", "t1_product", "usb_config", "firmware_version", "firmware_images",
           "touchbar_bound", "touchbar_driver_available", "camera", "light_sensor", "boot_service",
           "touchbar_service", "installed"],
    "wifi": ["state", "present", "subsystem", "driver", "any_driver", "any_pci", "any_operstate", "operstate",
             "board_file_installed", "board_file_ok", "mac_is_placeholder", "networkmanager", "networkmanager_ok",
             "driver_option_ok", "restart_pending", "board_file_cached", "installed"],
    "audio": ["state", "present", "supported", "subsystem", "chip_name", "driver", "active", "package_version",
              "module_built", "foreign", "missing_tools", "restart_pending", "installed"],
}
SAFE = re.compile(r"[A-Za-z0-9 ._:/+,()=;-]{0,120}")
def clean(v):
    if isinstance(v, bool) or isinstance(v, int):
        return v
    v = str(v)
    return v if SAFE.fullmatch(v) else re.sub(r"[^A-Za-z0-9 ._:/+,()=;-]", "?", v)[:120]
facts = {k: clean(status.get(k, "")) for k in FACTS[module]}
if module == "audio":
    facts["dkms"] = clean(dkms)
diag = {"schema": 1, "kind": "diagnostic", "module": module, "verdict": verdict, "date": date, "pomona": pomona,
        "model": clean(model), "board": clean(board), "mac_firmware": clean(fw), "distribution": clean(distro)[:60],
        "kernel": clean(kernel)[:60], "desktop": clean(desktop)[:40], "facts": facts}
with open(out, "w", encoding="utf-8") as f:
    json.dump(diag, f, indent=2)
    f.write("\n")
PYEOF
	cat "$base.json"
	echo
	echo "written: $base.json"
	if [ "$share" = 1 ]; then cmd_share "$base.json"; fi
	return 0
}

case "${1:-status}" in
	start) et1_start;;
	stop) et1_stop;;
	status) shift; cmd_status "$@";;
	certify) shift; cmd_certify "$@";;
	share) shift; cmd_share "$@";;
	wifi) shift; cmd_wifi "$@";;
	audio) shift; cmd_audio "$@";;
	diagnose) shift; cmd_diagnose "$@";;
	version|--version|-V) echo "Pomona $POMONA_VERSION";;
	help|-h|--help) sed -n '2,12p' "$_self" | sed 's/^# \{0,1\}//';;
	*) echo "pomona: unknown command $1 (try: pomona help)" >&2; exit 2;;
esac
