def mascot_texture():
    """The Pomona mascot, from the source checkout or <prefix>/share/pomona."""
    for path in (os.path.join(REPO, "assets", "pomona-mascot-256.png"),
                 os.path.join(REPO, "share", "pomona", "pomona-mascot-256.png")):
        if os.path.exists(path):
            try:
                return Gdk.Texture.new_from_filename(path)
            except GLib.Error:
                return None
    return None


def app_version():
    lib = os.path.join(REPO, "lib", "pomona.sh")
    if not os.path.exists(lib):
        lib = os.path.join(REPO, "lib", "pomona", "pomona.sh")
    try:
        with open(lib) as f:
            for line in f:
                if line.startswith("POMONA_VERSION="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return ""

# ------------------------------------------------------------------ i18n
# Translations are standard gettext catalogs (po/*.po), compiled to
# <prefix>/share/locale/<lang>/LC_MESSAGES/pomona.mo. Running from a source
# checkout, `make mo` puts them in ./locale.

DOMAIN = "pomona"


def locale_dirs():
    env = os.environ.get("POMONA_LOCALEDIR")
    if env:
        return [env]
    return [os.path.join(REPO, "locale"), os.path.join(REPO, "share", "locale")]


def load_translation():
    for d in locale_dirs():
        if os.path.isdir(d):
            t = gettext.translation(DOMAIN, d, fallback=True)
            if type(t) is not gettext.NullTranslations:
                return t
    return gettext.NullTranslations()


_translation = load_translation()


def _(text):
    return _translation.gettext(text)


# ------------------------------------------------------------------ helpers

def pomona_cmd():
    local = os.path.join(REPO, "bin", "pomona")
    if os.path.exists(local):
        return [local]
    return [shutil.which("pomona") or "/usr/bin/pomona"]


def run_async(argv, done):
    """Run argv, call done(ok, output) on the main loop."""
    try:
        proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
    except GLib.Error as e:
        done(False, e.message)
        return

    def finish(p, res):
        try:
            _ok, out, _err = p.communicate_utf8_finish(res)
        except GLib.Error as e:
            done(False, e.message)
            return
        done(p.get_successful(), out or "")

    proc.communicate_utf8_async(None, None, finish)


def read_config():
    try:
        with open(CONFIG) as f:
            raw = json.load(f)
    except (OSError, ValueError):
        raw = {}
    cfg = {"default_mode": 2, "fn_swaps": True, "autodim": True, "dim_timeout": 60,
           "idle_timeout": 15, "app_profiles": {}}
    cfg.update({k: v for k, v in raw.items() if k in cfg})
    return cfg


def parse_extension_info(text):
    """'active' | 'pending' | 'installed' | 'missing' from `LC_ALL=C gnome-extensions info`."""
    if not text.strip():
        return "missing"
    fields = {}
    for line in text.splitlines():
        key, sep, value = line.strip().partition(":")
        if sep:
            fields[key.strip().lower()] = value.strip().upper()
    if fields.get("enabled") != "YES":
        return "installed"
    # enabled, but GNOME on Wayland loads a newly installed extension only at the next login
    return "active" if fields.get("state") in ("ACTIVE", "ENABLED") else "pending"


def extension_dirs():
    return [os.path.join(GLib.get_user_data_dir(), "gnome-shell", "extensions"),
            "/usr/local/share/gnome-shell/extensions", "/usr/share/gnome-shell/extensions"]


def extension_on_disk(dirs=None):
    """True when the extension's files are installed, whether or not GNOME has loaded them."""
    return any(os.path.exists(os.path.join(d, EXT_UUID, "metadata.json")) for d in (dirs or extension_dirs()))


def extension_state():
    """'active' | 'pending' | 'installed' | 'missing'

    GNOME Shell on Wayland only discovers a newly installed extension at the next login,
    so "gnome-extensions info" knows nothing of it right after installing Pomona. When the
    files are on disk, that is not "missing": the session just has to be restarted.
    """
    state = "missing"
    exe = shutil.which("gnome-extensions")
    if exe:
        try:
            import subprocess
            env = dict(os.environ, LC_ALL="C", LANGUAGE="")
            out = subprocess.run([exe, "info", EXT_UUID], capture_output=True, text=True, timeout=5, env=env).stdout
            state = parse_extension_info(out)
        except Exception:
            state = "missing"
    if state == "missing" and extension_on_disk():
        return "pending"
    return state


def app_info(app_id):
    for candidate in (app_id, app_id + ".desktop"):
        try:
            info = Gio.DesktopAppInfo.new(candidate)
        except TypeError:
            info = None
        if info:
            return info
    return None


# ------------------------------------------------------------------ libadwaita compatibility
# Ubuntu 22.04 and its derivatives ship libadwaita 1.1; ToolbarView, SwitchRow and
# SpinRow arrived in 1.4 and Dialog in 1.5. These helpers use them when present
# and build the same thing from older widgets otherwise.
# POMONA_OLD_ADW=1 forces the fallbacks, to test them on a newer system.

def has_adw(name):
    return hasattr(Adw, name) and not os.environ.get("POMONA_OLD_ADW")


def toolbar(header, content):
    if has_adw("ToolbarView"):
        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.set_content(content)
        return view
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    content.set_vexpand(True)
    box.append(header)
    box.append(content)
    return box


def switch_row(title, subtitle=None):
    if has_adw("SwitchRow"):
        row = Adw.SwitchRow(title=title)
        if subtitle:
            row.set_subtitle(subtitle)
        return row, row
    row = Adw.ActionRow(title=title)
    if subtitle:
        row.set_subtitle(subtitle)
    sw = Gtk.Switch(valign=Gtk.Align.CENTER)
    row.add_suffix(sw)
    row.set_activatable_widget(sw)
    return row, sw


def spin_row(title, low, high):
    if has_adw("SpinRow"):
        row = Adw.SpinRow.new_with_range(low, high, 1)
        row.set_title(title)
        return row, row
    row = Adw.ActionRow(title=title)
    spin = Gtk.SpinButton.new_with_range(low, high, 1)
    spin.set_valign(Gtk.Align.CENTER)
    row.add_suffix(spin)
    return row, spin


def present_dialog(parent, title, content):
    """Shows content in a modal dialog; returns a function that closes it."""
    header = Adw.HeaderBar()
    if has_adw("Dialog"):
        dialog = Adw.Dialog(title=title, content_width=420, content_height=560)
        dialog.set_child(toolbar(header, content))
        dialog.present(parent)
        return dialog.close
    win = Adw.Window(title=title, modal=True, transient_for=parent, default_width=420, default_height=560)
    win.set_content(toolbar(header, content))
    win.present()
    return win.close


def hardware_group(rows):
    """A 'Hardware' group: (title, value) rows, the empty values left out."""
    group = Adw.PreferencesGroup(title=_("Hardware"))
    for title, value in rows:
        if value:
            row = Adw.ActionRow(title=title, subtitle=GLib.markup_escape_text(str(value)), subtitle_selectable=True)
            row.add_css_class("property")
            group.add(row)
    return group


# ------------------------------------------------------------------ window

class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Pomona", default_width=720, default_height=760)
        self.status = {}
        self.cfg = read_config()

        self.toasts = Adw.ToastOverlay()
        header = Adw.HeaderBar()
        self.stack = Adw.ViewStack(hexpand=True)
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text=_("Refresh"))
        refresh.connect("clicked", lambda *_a: self.refresh())
        header.pack_end(refresh)
        about = Gtk.Button(icon_name="help-about-symbolic", tooltip_text=_("About Pomona"))
        about.connect("clicked", lambda *_a: self.show_about())
        header.pack_start(about)
        # the pages are listed in a sidebar on the left, so new modules never run out of room
        self.sidebar = Gtk.ListBox(selection_mode=Gtk.SelectionMode.BROWSE)
        self.sidebar.add_css_class("navigation-sidebar")
        self.sidebar.connect("row-selected", self.on_sidebar_row)
        side = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, child=self.sidebar, width_request=190)
        body = Gtk.Box()
        body.append(side)
        body.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        body.append(self.stack)
        self.stack.connect("notify::visible-child-name", lambda *_a: self.sync_sidebar())
        self.toasts.set_child(toolbar(header, body))
        self.set_content(self.toasts)

        self.setup_page = Adw.PreferencesPage()
        self.add_page(self.setup_page, "setup", _("Setup"), "emblem-system-symbolic")
        self.wifi = {}
        self.wifi_page = Adw.PreferencesPage()
        self.add_page(self.wifi_page, "wifi", _("Wi-Fi"), "network-wireless-symbolic")
        self.audio = {}
        self.audio_page = Adw.PreferencesPage()
        self.add_page(self.audio_page, "audio", _("Audio"), "audio-speakers-symbolic")
        self.report_page = Adw.PreferencesPage()
        self.add_page(self.report_page, "report", _("Report"), "emblem-documents-symbolic")
        self.touchbar_page = Adw.PreferencesPage()
        self.add_page(self.touchbar_page, "touchbar", _("Touch Bar"), "input-keyboard-symbolic")
        self.sync_sidebar()

        self.build_touchbar_page()
        self.build_report_page()
        self.refresh()

    # -------------------------------------------------------------- common

    def add_page(self, page, name, title, icon):
        self.stack.add_titled_with_icon(page, name, title, icon)
        box = Gtk.Box(spacing=12, margin_top=6, margin_bottom=6, margin_start=6, margin_end=6)
        box.append(Gtk.Image.new_from_icon_name(icon))
        box.append(Gtk.Label(label=title, xalign=0, hexpand=True))
        row = Gtk.ListBoxRow(child=box)
        row.page_name = name
        self.sidebar.append(row)

    def on_sidebar_row(self, _box, row):
        if row is not None and self.stack.get_visible_child_name() != row.page_name:
            self.stack.set_visible_child_name(row.page_name)

    def sync_sidebar(self):
        name = self.stack.get_visible_child_name()
        row = self.sidebar.get_first_child()
        while row is not None:
            if getattr(row, "page_name", None) == name:
                if self.sidebar.get_selected_row() is not row:
                    self.sidebar.select_row(row)
                return
            row = row.get_next_sibling()

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=3))

    def clear(self, page):
        # PreferencesPage wraps groups in internal containers: remove what we added
        for g in getattr(page, "_groups", []):
            page.remove(g)
        page._groups = []

    def set_hardware(self, page, rows):
        """Put (or replace) the Hardware group at the end of a page."""
        old = getattr(page, "_hardware", None)
        if old is not None:
            page.remove(old)
        page._hardware = hardware_group(rows)
        page.add(page._hardware)

    def add_group(self, page, group):
        page.add(group)
        page._groups = getattr(page, "_groups", []) + [group]

    def admin(self, args, label, then=None):
        admin = installed_admin() or os.path.join(REPO, "libexec", "pomona-admin")
        self.toast(_("Working…"))

        def done(ok, out):
            self.toast(_("Done") if ok else "%s: %s" % (_("Failed"), (out.strip().splitlines() or [""])[-1]))
            if then:
                then(ok, out)
            self.refresh()

        run_async(["pkexec", admin] + args, done)

    def refresh(self):
        def done(ok, out):
            try:
                self.status = json.loads(out) if ok else {}
            except ValueError:
                self.status = {}
            self.build_setup_page()
            self.update_extension_row()
            self.build_hardware_pages()

        run_async(pomona_cmd() + ["status", "--json"], done)

        def wifi_done(ok, out):
            try:
                self.wifi = json.loads(out) if ok else {}
            except ValueError:
                self.wifi = {}
            self.build_wifi_page()

        run_async(pomona_cmd() + ["wifi", "status", "--json"], wifi_done)

        def audio_done(ok, out):
            try:
                self.audio = json.loads(out) if ok else {}
            except ValueError:
                self.audio = {}
            self.build_audio_page()

        run_async(pomona_cmd() + ["audio", "status", "--json"], audio_done)

    def build_hardware_pages(self):
        s = self.status
        bound = bool(s.get("touchbar_bound"))
        self.set_hardware(self.touchbar_page, [
            (_("Touch Bar"), _("Bound to hid-appletb-kbd") if bound else _("Not bound")),
            (_("T1 chip"), s.get("t1_product")),
            (_("Kernel"), s.get("kernel")),
        ])
        self.set_hardware(self.report_page, [
            (_("Model"), s.get("model")), (_("Mac firmware"), s.get("mac_firmware")),
            (_("Kernel"), s.get("kernel")), (_("Distribution"), s.get("distribution")),
            (_("Desktop"), os.environ.get("XDG_CURRENT_DESKTOP", "")),
        ])

    def show_about(self):
        dialog = Gtk.AboutDialog(
            transient_for=self, modal=True,
            program_name="Pomona", logo_icon_name="io.github.MarcoDiGioia.Pomona", version=app_version(),
            comments=_("Touch Bar, camera, light sensor and Wi-Fi for 2016–2017 MacBook Pro") + "\n\n" + _(DISCLAIMER),
            license_type=Gtk.License.GPL_3_0, authors=["Marco Di Gioia"],
            copyright="© 2026 Marco Di Gioia")
        dialog.present()

    # -------------------------------------------------------------- setup

    def step(self, group, title, ok, subtitle, button=None, action=None):
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        icon = Gtk.Image.new_from_icon_name("emblem-ok-symbolic" if ok else "dialog-warning-symbolic")
        icon.add_css_class("success" if ok else "warning")
        row.add_prefix(icon)
        if button and not ok and action:
            b = Gtk.Button(label=button, valign=Gtk.Align.CENTER)
            b.add_css_class("suggested-action")
            b.connect("clicked", lambda *_a: action())
            row.add_suffix(b)
        group.add(row)
        return ok

    def build_setup_page(self):
        s = self.status
        page = self.setup_page
        self.clear(page)

        mac = Adw.PreferencesGroup(title=_("This Mac"))
        model = s.get("model") or "?"
        is_t1 = s.get("model_class") == "t1"
        mac.add(Adw.ActionRow(title=_("Model"), subtitle="%s · %s" % (
            model, _("T1 Touch Bar MacBook Pro") if is_t1 else _("Not a T1 Mac: Pomona cannot help here"))))
        self.add_group(page, mac)

        steps = Adw.PreferencesGroup(title=_("Steps"), description=_("Every step is listed; the ones not done yet have a button."))
        self.add_group(page, steps)
        installed = bool(s.get("installed"))
        fw_ok = bool(s.get("firmware"))
        t1 = s.get("t1_state")
        oks = []
        oks.append(self.step(steps, _("T1 firmware on the EFI partition"), fw_ok,
                             "%s (%s)" % (s.get("firmware"), s.get("firmware_version")) if fw_ok else
                             _("Missing: boot macOS once, or see the troubleshooting guide")))
        oks.append(self.step(steps, _("Pomona installed"), installed,
                             os.path.dirname(installed_admin() or "") if installed else _("Not installed yet"),
                             _("Install"), self.install))
        oks.append(self.step(steps, _("T1 chip running"), t1 == "booted",
                             {"booted": _("Running (05ac:8600)"), "recovery": _("Stuck in recovery mode (05ac:1281)")}
                             .get(t1, _("Not found on USB")),
                             _("Start the T1"), (lambda: self.admin(["start"], "start")) if installed else None))
        # every step is always listed; the ones after "T1 chip running" can only
        # be fixed once the chip runs, so until then they wait without a button
        booted = t1 == "booted"
        start = (lambda: self.admin(["start"], "start")) if installed and booted else None
        waiting = _("Waits for the T1 chip")
        cfg_ok = s.get("usb_config") == "1"
        oks.append(self.step(steps, _("Camera, Touch Bar and light sensor visible"), cfg_ok,
                             "%s: %s" % (_("USB configuration"), s.get("usb_config") or "-") if booted else waiting,
                             _("Fix"), start))
        drv = s.get("touchbar_driver_available")
        bound = bool(s.get("touchbar_bound"))
        oks.append(self.step(steps, _("Touch Bar driver"), bound,
                             _("Bound to hid-appletb-kbd") if bound else
                             (_("Kernel too old: hid-appletb-kbd missing (needs 6.15+)") if not drv else
                              (_("Not bound") if booted else waiting)),
                             _("Fix"), start if drv else None))
        oks.append(self.step(steps, _("FaceTime camera"), bool(s.get("camera")),
                             _("Found") if s.get("camera") else (_("Not found") if booted else waiting)))
        oks.append(self.step(steps, _("Ambient light sensor"), bool(s.get("light_sensor")),
                             _("Found") if s.get("light_sensor") else (_("Not found") if booted else waiting)))
        enabled = s.get("boot_service") == "enabled" and s.get("touchbar_service") == "active"
        oks.append(self.step(steps, _("Start automatically at every power-on"), enabled,
                             _("Enabled") if enabled else _("Disabled"),
                             _("Enable"), (lambda: self.admin(["enable"], "enable")) if installed else None))

        if is_t1 and all(oks):
            done = Adw.PreferencesGroup()
            status = Adw.StatusPage(icon_name="emblem-ok-symbolic", title=_("Everything works"),
                                    description=_("Touch Bar, camera and light sensor are up."))
            mascot = mascot_texture()
            if mascot:
                status.set_paintable(mascot)
            done.add(status)
            self.add_group(page, done)

        t1_line = " · ".join(x for x in (s.get("t1_product"), "05ac:8600" if t1 == "booted" else
                                         ("05ac:1281" if t1 == "recovery" else ""),
                                         "%s %s" % (_("USB configuration"), s.get("usb_config")) if s.get("usb_config") else "") if x)
        mac_line = " · ".join(x for x in (s.get("model"), s.get("board")) if x)
        self.set_hardware(page, [
            (_("Model"), mac_line),
            (_("Mac firmware"), s.get("mac_firmware")),
            (_("T1 chip"), t1_line),
            (_("FaceTime camera"), s.get("camera_name")),
            (_("Ambient light sensor"), "als" if s.get("light_sensor") else ""),
            (_("Kernel"), s.get("kernel")),
            (_("Distribution"), s.get("distribution")),
        ])

    def install(self):
        script = os.path.join(REPO, "install.sh")
        if not os.path.exists(script):
            self.toast(_("Failed"))
            return
        self.toast(_("Working…"))
        run_async(["pkexec", "bash", script], lambda ok, out: (self.toast(_("Done") if ok else _("Failed")), self.refresh()))

    # -------------------------------------------------------------- wifi

    def wifi_fix(self):
        def run(extra):
            self.admin(["wifi-fix"] + extra, "wifi-fix",
                       then=lambda ok, _out: ok and self.toast(_("Restart the computer to finish")))

        w = self.wifi
        if w.get("board_file_ok") or w.get("board_file_cached"):
            run([])  # nothing to download
            return
        # the board file is not part of Pomona: ask before downloading it
        close = [None]
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                      margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        label = Gtk.Label(wrap=True, xalign=0, label=_(
            "The Wi-Fi card needs a board file that Pomona does not include. It will be downloaded from a public "
            "GitHub page where the Linux community shares it, and checked against a known SHA-256 before use. "
            "Its author and licence are not known. Nothing about you is sent."))
        box.append(label)
        offline = Gtk.Label(wrap=True, xalign=0, label=_(
            "No connection? Connect the Mac temporarily with a cable (a phone’s USB tethering works too), or on another computer save the file from this address, copy it here and choose “I have the file…”."))
        offline.add_css_class("dim-label")
        box.append(offline)
        address = Gtk.Label(wrap=True, xalign=0, selectable=True, label=BOARD_FILE_URL)
        address.add_css_class("monospace")
        box.append(address)
        buttons = Gtk.Box(spacing=12, halign=Gtk.Align.END)
        cancel = Gtk.Button(label=_("Cancel"))
        cancel.connect("clicked", lambda *_a: close[0]())
        have = Gtk.Button(label=_("I have the file…"))
        have.connect("clicked", lambda *_a: (close[0](), self.pick_board_file(run)))
        buttons.append(have)
        go = Gtk.Button(label=_("Download and fix"))
        go.add_css_class("suggested-action")
        go.connect("clicked", lambda *_a: (close[0](), run(["--download"])))
        buttons.append(cancel)
        buttons.append(go)
        box.append(buttons)
        close[0] = present_dialog(self, _("Download the board file?"), box)

    def pick_board_file(self, run):
        dialog = Gtk.FileChooserNative(title=_("Choose the board file"), transient_for=self,
                                       action=Gtk.FileChooserAction.OPEN)

        def response(d, code):
            if code == Gtk.ResponseType.ACCEPT and d.get_file() and d.get_file().get_path():
                run(["--board-file", d.get_file().get_path()])

        dialog.connect("response", response)
        self._chooser = dialog  # keep it alive
        dialog.show()

    def build_wifi_page(self):
        w = self.wifi
        page = self.wifi_page
        self.clear(page)
        present = bool(w.get("present"))

        # the status comes first, whatever the card
        iface = w.get("any_interface") or ""
        status = Adw.PreferencesGroup(title=_("Wi-Fi status"))
        if not iface:
            status.add(Adw.ActionRow(title=_("No Wi-Fi card found")))
        else:
            up = w.get("any_operstate") == "up"
            self.step(status, _("Connected to a network"), up, _("Connected") if up else _("Not connected"))
        self.add_group(page, status)
        if present:
            chip = "Broadcom BCM43602 (14e4:43ba)"
        else:
            chip = w.get("any_pci") or ""
        hardware = [(_("Chip"), chip), (_("Subsystem"), w.get("subsystem") if present else ""),
                    (_("Driver"), w.get("any_driver")), (_("Network interface"), iface),
                    (_("MAC address"), w.get("any_mac")), (_("Kernel"), w.get("kernel"))]
        if not present:
            if iface:
                note = Adw.PreferencesGroup()
                note.add(Adw.ActionRow(title=_("Nothing to fix"),
                                       subtitle=_("Pomona has no fix for this card: it is not needed or not supported yet")))
                self.add_group(page, note)
            self.set_hardware(page, hardware)
            return

        card = Adw.PreferencesGroup(
            title="Broadcom BCM43602",
            description=_("This Mac’s Broadcom card sees networks but rejects every connection until its board file is installed."))
        self.add_group(page, card)

        steps = Adw.PreferencesGroup(title=_("Steps"), description=_("Every step is listed; the ones not done yet have a button."))
        self.add_group(page, steps)
        installed = bool(w.get("installed"))
        fix = self.wifi_fix if installed else None
        oks = []
        driver = w.get("driver") or ""
        oks.append(self.step(steps, _("Driver"), driver == "brcmfmac", driver or _("Not loaded")))
        board_ok = bool(w.get("board_file_ok"))
        oks.append(self.step(steps, _("Board file"), board_ok,
                             _("Installed") if board_ok else
                             (_("Different from the expected file") if w.get("board_file_installed")
                              else _("Missing: every connection is rejected without it")),
                             _("Fix"), fix))
        nm_ok = bool(w.get("networkmanager_ok"))
        oks.append(self.step(steps, _("Real MAC address"), nm_ok,
                             (_("NetworkManager keeps the card’s own address") if w.get("networkmanager")
                              else _("NetworkManager is not used")) if nm_ok else
                             _("NetworkManager replaces it with a random one, which the card refuses"),
                             _("Fix"), fix))
        oks.append(self.step(steps, _("Driver option"), bool(w.get("driver_option_ok")),
                             _("Set") if w.get("driver_option_ok") else _("Not set"), _("Fix"), fix))
        own = not w.get("mac_is_placeholder")
        oks.append(self.step(steps, _("Own MAC address"), own,
                             _("This Mac has its own address") if own else
                             _("Every copy of the board file shares one address: give this Mac its own"),
                             _("Fix"), fix))
        oks.append(w.get("any_operstate") == "up")
        pending = bool(w.get("restart_pending"))
        if pending:
            oks.append(self.step(steps, _("Restart needed"), False,
                                 _("Restart the computer to load the new board file")))

        if all(oks):
            done = Adw.PreferencesGroup()
            done.add(Adw.StatusPage(icon_name="emblem-ok-symbolic", title=_("Wi-Fi is set up"),
                                    description=_("The card is ready and connected.")))
            self.add_group(page, done)

        tools = Adw.PreferencesGroup()
        undo_row = Adw.ActionRow(title=_("Undo the changes"),
                                 subtitle=_("Puts every file back as it was before the last fix"))
        undo = Gtk.Button(label=_("Undo"), valign=Gtk.Align.CENTER, sensitive=installed and bool(w.get("backup")))
        undo.connect("clicked", lambda *_a: self.admin(
            ["wifi-undo"], "wifi-undo", then=lambda ok, _out: ok and self.toast(_("Restart the computer to finish"))))
        undo_row.add_suffix(undo)
        tools.add(undo_row)
        cert_row = Adw.ActionRow(title=_("Compatibility certificate"),
                                 subtitle=_("Runs the Wi-Fi checks and writes a report you can share"))
        cert = Gtk.Button(label=_("Create certificate"), valign=Gtk.Align.CENTER)
        cert.connect("clicked", lambda *_a: self.certify(["wifi", "certify"]))
        cert_row.add_suffix(cert)
        tools.add(cert_row)
        self.add_group(page, tools)
        self.set_hardware(page, hardware)

    # -------------------------------------------------------------- audio

    def audio_fix(self):
        # the driver is not part of Pomona: ask before downloading it
        close = [None]
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                      margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        box.append(Gtk.Label(wrap=True, xalign=0, label=_(
            "The sound driver for Macs is not part of Pomona. It will be downloaded from the snd_hda_macbookpro "
            "project on GitHub (GPL-2.0) and checked against known SHA-256 sums. To build it, the source of your "
            "kernel is downloaded too, now and at every kernel update. Nothing about you is sent.")))
        note = Gtk.Label(wrap=True, xalign=0, label=_("Building the driver takes a few minutes."))
        note.add_css_class("dim-label")
        box.append(note)
        address = Gtk.Label(wrap=True, xalign=0, selectable=True, label=AUDIO_DRIVER_URL)
        address.add_css_class("monospace")
        box.append(address)
        buttons = Gtk.Box(spacing=12, halign=Gtk.Align.END)
        cancel = Gtk.Button(label=_("Cancel"))
        cancel.connect("clicked", lambda *_a: close[0]())
        go = Gtk.Button(label=_("Download and fix"))
        go.add_css_class("suggested-action")
        go.connect("clicked", lambda *_a: (close[0](), self.admin(
            ["audio-fix", "--download"], "audio-fix",
            then=lambda ok, _out: ok and self.toast(_("Restart the computer to finish")))))
        buttons.append(cancel)
        buttons.append(go)
        box.append(buttons)
        close[0] = present_dialog(self, _("Download the sound driver?"), box)

    def build_audio_page(self):
        a = self.audio
        page = self.audio_page
        self.clear(page)
        present = bool(a.get("present"))
        hardware = [(_("Chip"), "Cirrus Logic CS8409 (10138409)" if present else ""),
                    (_("Subsystem"), a.get("subsystem")), (_("Codec"), a.get("chip_name")),
                    (_("Driver"), a.get("driver")), (_("Kernel"), a.get("kernel"))]

        status = Adw.PreferencesGroup(title=_("Audio status"))
        if not present:
            status.add(Adw.ActionRow(title=_("No Cirrus Logic CS8409 sound chip found"),
                                     subtitle=_("Pomona has no fix for this Mac’s sound: it is not needed or not supported yet")))
            self.add_group(page, status)
            self.set_hardware(page, hardware)
            return
        active = bool(a.get("active"))
        self.step(status, _("Speakers and headphones"), active,
                  _("Working") if active else _("Silent: the kernel’s own driver does not switch on the Mac’s amplifiers"))
        self.add_group(page, status)

        card = Adw.PreferencesGroup(
            title="Cirrus Logic CS8409",
            description=_("The kernel’s driver for this sound chip does not switch on the Mac’s amplifiers: the speakers stay silent until the Mac driver is installed."))
        self.add_group(page, card)
        state = a.get("state")
        if state == "unsupported":
            card.add(Adw.ActionRow(title=_("Not supported yet"),
                                   subtitle=_("The driver does not know this Mac’s amplifiers yet")))
            self.set_hardware(page, hardware)
            return

        steps = Adw.PreferencesGroup(title=_("Steps"), description=_("Every step is listed; the ones not done yet have a button."))
        self.add_group(page, steps)
        installed = bool(a.get("installed"))
        missing = a.get("missing_tools") or ""
        fix = self.audio_fix if installed and not missing and not a.get("foreign") else None
        oks = []
        if missing:
            oks.append(self.step(steps, _("Build tools"), False, _("Missing: %s") % missing))
        if a.get("foreign"):
            oks.append(self.step(steps, _("Another driver is installed"), False,
                                 _("Remove it first: %s") % a.get("foreign")))
        added = bool(a.get("package"))
        oks.append(self.step(steps, _("Mac sound driver"), added,
                             _("Installed, rebuilt at every kernel update") if added else _("Not installed"),
                             _("Fix"), fix))
        if added:
            built = bool(a.get("module_built"))
            oks.append(self.step(steps, _("Built for this kernel"), built,
                                 _("Built") if built else _("Not built: run the fix again with a connection"),
                                 _("Fix"), fix))
        oks.append(active)
        if state == "restart":
            oks.append(self.step(steps, _("Restart needed"), False, _("Restart the computer to load the new driver")))

        if all(oks):
            done = Adw.PreferencesGroup()
            done.add(Adw.StatusPage(icon_name="emblem-ok-symbolic", title=_("Sound is set up"),
                                    description=_("The Mac driver is in use.")))
            self.add_group(page, done)

        tools = Adw.PreferencesGroup()
        undo_row = Adw.ActionRow(title=_("Undo the changes"),
                                 subtitle=_("Removes the Mac sound driver: the kernel’s own one is used after a restart"))
        undo = Gtk.Button(label=_("Undo"), valign=Gtk.Align.CENTER, sensitive=installed and added)
        undo.connect("clicked", lambda *_a: self.admin(
            ["audio-undo"], "audio-undo", then=lambda ok, _out: ok and self.toast(_("Restart the computer to finish"))))
        undo_row.add_suffix(undo)
        tools.add(undo_row)
        cert_row = Adw.ActionRow(title=_("Compatibility certificate"),
                                 subtitle=_("Runs the audio checks and writes a report you can share"))
        cert = Gtk.Button(label=_("Create certificate"), valign=Gtk.Align.CENTER)
        cert.connect("clicked", lambda *_a: self.certify(["audio", "certify"]))
        cert_row.add_suffix(cert)
        tools.add(cert_row)
        self.add_group(page, tools)
        self.set_hardware(page, hardware)

