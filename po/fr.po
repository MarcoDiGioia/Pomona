msgstr "Touch Bar, caméra et capteur de lumière sont actifs."

msgid "Keys"
msgstr "Touches"

msgid "What the Touch Bar shows"
msgstr "Ce qu’affiche la Touch Bar"

msgid "Default key set"
msgstr "Touches par défaut"

msgid "Esc only"
msgstr "Échap uniquement"

msgid "F1–F12"
msgstr "F1–F12"

msgid "Special keys"
msgstr "Touches spéciales"

msgid "Fn switches key set"
msgstr "Fn change les touches"

msgid "While Fn is held, F1–F12 and special keys swap"
msgstr "Tant que Fn est enfoncée, F1–F12 et les touches spéciales s’échangent"

msgid "Dimming"
msgstr "Atténuation"

msgid "Dim when idle"
msgstr "Atténuer en cas d’inactivité"

msgid "Seconds before dimming"
msgstr "Secondes avant l’atténuation"

msgid "Seconds before turning off"
msgstr "Secondes avant l’extinction"

msgid "Applications"
msgstr "Applications"

msgid "A key set for the application in the foreground"
msgstr "Des touches propres à l’application au premier plan"

msgid "Add application"
msgstr "Ajouter une application"

msgid "Remove"
msgstr "Supprimer"

msgid "GNOME Shell extension"
msgstr "Extension GNOME Shell"

msgid "Needed to know which application is in the foreground"
msgstr "Nécessaire pour savoir quelle application est au premier plan"

msgid "Active"
msgstr "Active"

msgid "Installed, not active"
msgstr "Installée, inactive"

msgid "Not installed (install Pomona first)"
msgstr "Non installée (installez d’abord Pomona)"

msgid "Log out and back in, then press Refresh"
msgstr "Fermez la session et rouvrez-la, puis appuyez sur Actualiser"

