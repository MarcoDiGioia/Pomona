msgstr "Necesaria para saber qué aplicación está en primer plano"

msgid "Active"
msgstr "Activa"

msgid "Installed, not active"
msgstr "Instalada, no activa"

msgid "Not installed (install Pomona first)"
msgstr "No instalada (instala primero Pomona)"

