<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Pomona</vendor>
  <action id="io.github.MarcoDiGioia.Pomona.admin">
    <description>Configure the Apple T1, Touch Bar and Wi-Fi card</description>
    <description xml:lang="it">Configurare il chip Apple T1, la Touch Bar e la scheda Wi-Fi</description>
    <description xml:lang="de">Den Apple-T1-Chip, die Touch Bar und die WLAN-Karte konfigurieren</description>
    <description xml:lang="es">Configurar el chip Apple T1, la Touch Bar y la tarjeta Wi-Fi</description>
    <description xml:lang="fr">Configurer la puce Apple T1, la Touch Bar et la carte Wi-Fi</description>
    <description xml:lang="nl">De Apple T1-chip, de Touch Bar en de wifikaart configureren</description>
    <description xml:lang="pl">Konfiguracja układu Apple T1, Touch Bara i karty Wi-Fi</description>
    <description xml:lang="pt">Configurar o chip Apple T1, a Touch Bar e a placa Wi-Fi</description>
    <message>Authentication is required to start the T1, change the Touch Bar settings or fix the Wi-Fi card</message>
    <message xml:lang="it">Serve la password per avviare il T1, cambiare le impostazioni della Touch Bar o sistemare la scheda Wi-Fi</message>
    <message xml:lang="de">Zum Starten des T1, Ändern der Touch-Bar-Einstellungen oder Reparieren der WLAN-Karte ist eine Authentifizierung erforderlich</message>
    <message xml:lang="es">Se necesita autenticación para iniciar el T1, cambiar los ajustes de la Touch Bar o arreglar la tarjeta Wi-Fi</message>
    <message xml:lang="fr">Une authentification est nécessaire pour démarrer le T1, modifier les réglages de la Touch Bar ou réparer la carte Wi-Fi</message>
    <message xml:lang="nl">Authenticatie is nodig om de T1 te starten, de Touch Bar-instellingen te wijzigen of de wifikaart te repareren</message>
    <message xml:lang="pl">Do uruchomienia T1, zmiany ustawień Touch Bara lub naprawy karty Wi-Fi wymagane jest uwierzytelnienie</message>
    <message xml:lang="pt">É necessária autenticação para iniciar o T1, alterar as definições da Touch Bar ou reparar a placa Wi-Fi</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@PREFIX@/lib/pomona/pomona-admin</annotate>
  </action>
</policyconfig>
